diff --git a/expenses/report.py b/expenses/report.py
index 9db9415..749428a 100644
--- a/expenses/report.py
+++ b/expenses/report.py
@@ -27,6 +27,14 @@ class Formatter(Protocol):
     def render(self, expenses: list[Expense]) -> str: ...
 
 
+_FORMULA_PREFIXES = ("=", "+", "-", "@", "\t", "\r")
+
+
+def _safe_cell(value: str) -> str:
+    """Neutralise spreadsheet formula injection (OWASP CSV Injection)."""
+    return "'" + value if value.startswith(_FORMULA_PREFIXES) else value
+
+
 class CsvFormatter:
     extension = ".csv"
 
@@ -35,7 +43,10 @@ class CsvFormatter:
         writer = csv.writer(buf)
         writer.writerow(["date", "category", "description", "amount"])
         for e in expenses:
-            writer.writerow([e.date, e.category, e.description, e.amount])
+            writer.writerow([
+                _safe_cell(e.date), _safe_cell(e.category),
+                _safe_cell(e.description), e.amount,
+            ])
         return buf.getvalue()
 
 
